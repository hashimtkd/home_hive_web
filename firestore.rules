rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the specific admin email has admin access.
    // We check email only (not email_verified) to avoid blocking admin
    // if email verification is not yet set up in Firebase Auth console.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'hashimtech336@gmail.com';
    }

    // Products Collection
    match /products/{productId} {
      // ✅ Public users can read products
      allow read: if true;
      // 🔒 Only the admin can create, update, or delete products
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // ✅ Public users (customers) can create orders
      allow create: if true;
      // 🔒 Only the admin can read, update, or delete orders
      allow read, update, delete: if isAdmin();
    }

    // Settings Collection
    match /settings/{document=**} {
      // 🔒 Only the admin can access settings
      allow read, write: if isAdmin();
    }

    // ❌ Deny all access to every other collection by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
